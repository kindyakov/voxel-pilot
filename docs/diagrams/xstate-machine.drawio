<mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="state-MAIN_ACTIVITY-OBSERVATION_WAIT" value="&lt;div&gt;&lt;b&gt;OBSERVATION_WAIT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Execution canceled until valid observations return; no flight.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#334155;fontColor=#111827;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="90" y="305" width="250" height="100" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-WAITING" value="&lt;div&gt;&lt;b&gt;WAITING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Controller stopped. Resume on a usable target or bounded changed-condition retry.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT"><mxGeometry x="1100" y="210" width="220" height="85" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-RETREATING" value="&lt;div&gt;&lt;b&gt;RETREATING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Creeper danger only; finish when no dangerous creeper remains nearby.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT"><mxGeometry x="1345" y="200" width="285" height="270" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RUNNING" value="&lt;div&gt;&lt;b&gt;RUNNING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Eat when safe; otherwise defer&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING"><mxGeometry x="490" y="270" width="120" height="45" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RETRYING" value="&lt;div&gt;&lt;b&gt;RETRYING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Retry delay&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING"><mxGeometry x="625" y="270" width="120" height="45" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RUNNING" value="&lt;div&gt;&lt;b&gt;RUNNING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Observe / flee / eat&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING"><mxGeometry x="490" y="415" width="120" height="45" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RETRYING" value="&lt;div&gt;&lt;b&gt;RETRYING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Retry delay&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING"><mxGeometry x="625" y="415" width="120" height="45" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-RETREATING-RUNNING" value="&lt;div&gt;&lt;b&gt;RUNNING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Observe / flee&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT-RETREATING"><mxGeometry x="1360" y="340" width="115" height="75" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-RETREATING-RETRYING" value="&lt;div&gt;&lt;b&gt;RETRYING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Retry delay&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT-RETREATING"><mxGeometry x="1490" y="340" width="115" height="75" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY" value="&lt;div&gt;&lt;b&gt;MAIN_ACTIVITY&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Main runtime lane. Owns the active behavior: idle, urgent survival, combat, and AI-driven tasks.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1710" height="1260" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-IDLE" value="&lt;div&gt;&lt;b&gt;IDLE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Resting state. Waits for commands, combat triggers, or urgent needs.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#334155;fontColor=#111827;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="90" y="145" width="250" height="100" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-RESUMING" value="&lt;div&gt;&lt;b&gt;RESUMING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Replan the current goal or return to idle after recovery.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="355" y="185" width="70" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS" value="&lt;div&gt;&lt;b&gt;URGENT_NEEDS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;High-priority interrupt lane. Preempts other work when hunger or health crosses emergency thresholds.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="455" y="125" width="330" height="360" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING" value="&lt;div&gt;&lt;b&gt;EMERGENCY_EATING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Critical hunger recovery; safe no-food may resume.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS"><mxGeometry x="475" y="200" width="290" height="130" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING" value="&lt;div&gt;&lt;b&gt;EMERGENCY_HEALING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Continuous survival until healthy AND safe.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#fff7ed;strokeColor=#d97706;fontColor=#7c2d12;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-URGENT_NEEDS"><mxGeometry x="475" y="345" width="290" height="130" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT" value="&lt;div&gt;&lt;b&gt;COMBAT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Self-defense only. Melee, ranged or safe retreat; critical health preempts all modes.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="830" y="125" width="820" height="370" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-DECIDING" value="&lt;div&gt;&lt;b&gt;DECIDING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Re-evaluates the best combat mode.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT"><mxGeometry x="875" y="210" width="160" height="85" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-MELEE_ATTACKING" value="&lt;div&gt;&lt;b&gt;MELEE_ATTACKING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Owns PvP movement and close-range attack pressure.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT"><mxGeometry x="900" y="345" width="180" height="95" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-COMBAT-RANGED_SKIRMISHING" value="&lt;div&gt;&lt;b&gt;RANGED_SKIRMISHING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Owns ranged attacks while visibility and ammo allow it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-COMBAT"><mxGeometry x="1110" y="345" width="180" height="95" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS" value="&lt;div&gt;&lt;b&gt;TASKS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Agent loop. Converts a user goal into one tool decision at a time, executes it, records the result, and repeats.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY"><mxGeometry x="80" y="515" width="1600" height="765" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-IDLE" value="&lt;div&gt;&lt;b&gt;IDLE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Task subsystem is armed but has no active goal yet.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS"><mxGeometry x="125" y="600" width="210" height="85" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-THINKING" value="&lt;div&gt;&lt;b&gt;THINKING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Invokes the agent turn and chooses the next execution step or finish.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS"><mxGeometry x="400" y="590" width="240" height="105" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING" value="&lt;div&gt;&lt;b&gt;EXECUTING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Execution dispatcher. Routes pending tool work into primitive actors or the mining subworkflow.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS"><mxGeometry x="715" y="575" width="920" height="630" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-RESOLVE" value="&lt;div&gt;&lt;b&gt;RESOLVE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Chooses which executor branch handles the pending tool.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="760" y="650" width="180" height="85" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING" value="&lt;div&gt;&lt;b&gt;MINING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Specialized mining workflow with search, travel, break retries, completion tracking, and failure exits.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="970" y="635" width="620" height="300" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-CHECKING_PRECONDITIONS" value="&lt;div&gt;&lt;b&gt;CHECKING_PRECONDITIONS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Validates the mining request before spending work.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1010" y="710" width="145" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-SEARCHING" value="&lt;div&gt;&lt;b&gt;SEARCHING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Invokes block search for matching ore targets.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1190" y="710" width="125" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-CHECKING_DISTANCE" value="&lt;div&gt;&lt;b&gt;CHECKING_DISTANCE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Decides whether to break now or navigate first.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1340" y="710" width="145" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-NAVIGATING" value="&lt;div&gt;&lt;b&gt;NAVIGATING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Moves to the next ore candidate.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1095" y="820" width="140" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-BREAKING" value="&lt;div&gt;&lt;b&gt;BREAKING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Breaks the selected block and counts collection.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1270" y="820" width="125" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-CHECKING_GOAL" value="&lt;div&gt;&lt;b&gt;CHECKING_GOAL&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Checks goal completion, inventory pressure, and next target.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1430" y="820" width="135" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-TASK_COMPLETED" value="&lt;div&gt;&lt;b&gt;TASK_COMPLETED&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Records mining success and returns to decide-next.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1165" y="910" width="155" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING-TASK_FAILED" value="&lt;div&gt;&lt;b&gt;TASK_FAILED&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Records mining failure and returns to decide-next.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING-MINING"><mxGeometry x="1350" y="910" width="135" height="70" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-NAVIGATING" value="&lt;div&gt;&lt;b&gt;NAVIGATING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive navigate_to execution.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="760" y="980" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-BREAKING" value="&lt;div&gt;&lt;b&gt;BREAKING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive break_block execution.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="960" y="980" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-OPEN_WINDOW" value="&lt;div&gt;&lt;b&gt;OPEN_WINDOW&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive open_window execution with session capture.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="1160" y="980" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-TRANSFER_ITEM" value="&lt;div&gt;&lt;b&gt;TRANSFER_ITEM&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive transfer_item execution.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="1360" y="980" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-CLOSE_WINDOW" value="&lt;div&gt;&lt;b&gt;CLOSE_WINDOW&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive close_window execution with close-failure tracking.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="860" y="1090" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-PLACING" value="&lt;div&gt;&lt;b&gt;PLACING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive place_block execution.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="1060" y="1090" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-EXECUTING-FOLLOWING" value="&lt;div&gt;&lt;b&gt;FOLLOWING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Primitive follow_entity execution.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS-EXECUTING"><mxGeometry x="1260" y="1090" width="170" height="80" as="geometry"/></mxCell><mxCell id="state-MAIN_ACTIVITY-TASKS-DECIDE_NEXT" value="&lt;div&gt;&lt;b&gt;DECIDE_NEXT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Loops back to THINKING or aborts to IDLE on anti-loop protection.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#ecfeff;strokeColor=#0f766e;fontColor=#134e4a;strokeWidth=2" vertex="1" parent="state-MAIN_ACTIVITY-TASKS"><mxGeometry x="1450" y="1085" width="145" height="85" as="geometry"/></mxCell><mxCell id="state-MONITORING" value="&lt;div&gt;&lt;b&gt;MONITORING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Parallel monitors. Continuously watch health, hunger, and entity streams while MAIN_ACTIVITY runs.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;strokeWidth=2;dashed=1" vertex="1" parent="1"><mxGeometry x="1785" y="70" width="560" height="455" as="geometry"/></mxCell><mxCell id="state-MONITORING-HEALTH_MONITOR" value="&lt;div&gt;&lt;b&gt;HEALTH_MONITOR&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Routes low-health updates into urgent healing.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MONITORING"><mxGeometry x="1845" y="190" width="200" height="95" as="geometry"/></mxCell><mxCell id="state-MONITORING-HUNGER_MONITOR" value="&lt;div&gt;&lt;b&gt;HUNGER_MONITOR&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Routes low-food updates into urgent eating.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MONITORING"><mxGeometry x="2080" y="190" width="200" height="95" as="geometry"/></mxCell><mxCell id="state-MONITORING-ENTITIES_MONITOR" value="&lt;div&gt;&lt;b&gt;ENTITIES_MONITOR&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Owns observation failures and bounded restart; failure never proves safety.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;spacingTop=26;spacingLeft=16;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MONITORING"><mxGeometry x="1820" y="315" width="490" height="180" as="geometry"/></mxCell><mxCell id="state-MONITORING-ENTITIES_MONITOR-RUNNING" value="&lt;div&gt;&lt;b&gt;RUNNING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Invokes tracking and publishes current facts and targets.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MONITORING-ENTITIES_MONITOR"><mxGeometry x="1850" y="375" width="190" height="85" as="geometry"/></mxCell><mxCell id="state-MONITORING-ENTITIES_MONITOR-RETRYING" value="&lt;div&gt;&lt;b&gt;RETRYING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Invalidates freshness; waits for recoveryRetry before restarting.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=2" vertex="1" parent="state-MONITORING-ENTITIES_MONITOR"><mxGeometry x="2100" y="375" width="190" height="85" as="geometry"/></mxCell><mxCell id="note-root-entry" value="&lt;div&gt;&lt;b&gt;MINECRAFT_BOT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;Parallel XState root. MAIN_ACTIVITY owns current behavior; MONITORING keeps health, hunger, and entities hot.&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="45" as="geometry"/></mxCell><mxCell id="note-external-triggers" value="&lt;div&gt;&lt;b&gt;External triggers&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;USER_COMMAND -&amp;gt; THINKING (deferred during safety)
START_COMBAT -&amp;gt; COMBAT (self-defense only)
STOP_COMBAT cannot release safety
DEATH -&amp;gt; IDLE
STOP_CURRENT_GOAL cancels only the goal during safety
START_URGENT_NEEDS -&amp;gt; EMERGENCY_EATING or EMERGENCY_HEALING&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="1785" y="545" width="560" height="180" as="geometry"/></mxCell><mxCell id="note-agent-loop" value="&lt;div&gt;&lt;b&gt;Agent loop&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;THINKING invokes one agent turn, EXECUTING runs exactly one pending tool, DECIDE_NEXT loops until finish or anti-loop abort.&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ecfeff;strokeColor=#0f766e;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="1785" y="745" width="560" height="130" as="geometry"/></mxCell><mxCell id="note-mining" value="&lt;div&gt;&lt;b&gt;Mining workflow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;mine_resource is the only deep execution subtree. It validates preconditions, searches blocks, navigates, breaks, retries, and records completion or failure.&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="1785" y="895" width="560" height="150" as="geometry"/></mxCell><mxCell id="note-combat-services" value="&lt;div&gt;&lt;b&gt;Invoked actors&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;COMBAT: melee, ranged, tacticalRetreat
URGENT_NEEDS: emergencyEating / emergencyHealing
MONITORING: serviceEntitiesTracking&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="1785" y="1065" width="560" height="120" as="geometry"/></mxCell><mxCell id="note-legend" value="&lt;div&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; white-space:pre-line;&quot;&gt;Solid arrows = normal transitions
Animated arrows = hot loops worth watching
Dashed arrows = cross-lane or external triggers
State captions summarize purpose, not raw action lists&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=18;spacingLeft=12;fillColor=#ffffff;strokeColor=#111827;strokeWidth=1.5" vertex="1" parent="1"><mxGeometry x="1785" y="1205" width="560" height="120" as="geometry"/></mxCell><mxCell id="edge-observer-failed" value="THREAT_OBSERVATION_FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155" edge="1" parent="1" source="state-MONITORING-ENTITIES_MONITOR-RUNNING" target="state-MONITORING-ENTITIES_MONITOR-RETRYING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-observer-retry" value="after recoveryRetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155;dashed=1" edge="1" parent="1" source="state-MONITORING-ENTITIES_MONITOR-RETRYING" target="state-MONITORING-ENTITIES_MONITOR-RUNNING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-error-0" value="ERROR / failed attempt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155" edge="1" parent="1" source="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RUNNING" target="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RETRYING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-retry-0" value="after recoveryRetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155;dashed=1" edge="1" parent="1" source="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RETRYING" target="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_EATING-RUNNING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-error-1" value="ERROR / failed attempt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155" edge="1" parent="1" source="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RUNNING" target="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RETRYING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-retry-1" value="after recoveryRetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155;dashed=1" edge="1" parent="1" source="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RETRYING" target="state-MAIN_ACTIVITY-URGENT_NEEDS-EMERGENCY_HEALING-RUNNING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-error-2" value="ERROR / failed attempt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155" edge="1" parent="1" source="state-MAIN_ACTIVITY-COMBAT-RETREATING-RUNNING" target="state-MAIN_ACTIVITY-COMBAT-RETREATING-RETRYING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-safety-retry-2" value="after recoveryRetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155;dashed=1" edge="1" parent="1" source="state-MAIN_ACTIVITY-COMBAT-RETREATING-RETRYING" target="state-MAIN_ACTIVITY-COMBAT-RETREATING-RUNNING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-combat-retreat" value="nearby dangerous creeper" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#334155" edge="1" parent="1" source="state-MAIN_ACTIVITY-COMBAT" target="state-MAIN_ACTIVITY-COMBAT-RETREATING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-com