{
	"name": "@voxel-pilot/core",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./legacy-logger": {
			"types": "./dist/config/logger.d.ts",
			"development": "./src/config/logger.ts",
			"import": "./dist/config/logger.js"
		},
		"./paths": {
			"types": "./dist/runtimePaths.d.ts",
			"development": "./src/runtimePaths.ts",
			"import": "./dist/runtimePaths.js"
		},
		"./schematic": {
			"types": "./dist/building/schematicInspection.d.ts",
			"development": "./src/building/schematicInspection.ts",
			"import": "./dist/building/schematicInspection.js"
		},
		"./hsm-diagram": {
			"types": "./dist/hsm/utils/hsmDrawioDiagram.d.ts",
			"development": "./src/hsm/utils/hsmDrawioDiagram.ts",
			"import": "./dist/hsm/utils/hsmDrawioDiagram.js"
		},
		"./agents-sdk-pilot": {
			"types": "./dist/ai/agentSdkPilot.d.ts",
			"development": "./src/ai/agentSdkPilot.ts",
			"import": "./dist/ai/agentSdkPilot.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"test": "tsx --import ./src/tests/setupEnv.mjs --test --test-concurrency=1 \"src/tests/**/*.test.ts\"",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@openai/agents": "^0.18.0",
		"ajv": "^8.17.1",
		"chalk": "^4.1.2",
		"dotenv": "^17.2.1",
		"minecrafthawkeye": "1.3.9",
		"mineflayer": "4.39.0",
		"mineflayer-armor-manager": "^2.0.1",
		"mineflayer-auto-eat": "5.0.3",
		"mineflayer-movement": "^0.4.4",
		"mineflayer-pathfinder": "2.4.5",
		"mineflayer-pvp": "1.3.2",
		"mineflayer-tool": "^1.2.0",
		"mineflayer-web-inventory": "^1.8.5",
		"openai": "^7.19.0",
		"prismarine-nbt": "^2.8.0",
		"prismarine-viewer": "^1.33.0",
		"winston": "^3.17.0",
		"xstate": "^5.22.0",
		"zod": "^4.6.5",
		"vec3": "^0.1.10"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"prismarine-block": "^1.22.0",
		"prismarine-entity": "^2.5.0",
		"prismarine-item": "^1.14.0",
		"prismarine-recipe": "^1.3.1",
		"prismarine-registry": "1.12.0",
		"prismarine-world": "3.7.0",
		"tsc-alias": "^1.8.10",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"minecraft-data": "3.116.0",
		"prismarine-physics": "1.11.1"
	}
}
