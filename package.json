{
	"name": "voxel-pilot",
	"version": "0.0.1",
	"description": "VoxelPilot is an AI-assisted Minecraft bot built with mineflayer and XState.",
	"type": "module",
	"scripts": {
		"build": "pnpm -r run build",
		"type-check": "pnpm --filter @voxel-pilot/core run build && pnpm -r run type-check && tsc --noEmit",
		"start": "pnpm --filter @voxel-pilot/cli start",
		"dev": "pnpm --filter @voxel-pilot/cli dev",
		"inspect-schematic": "pnpm --filter @voxel-pilot/cli inspect-schematic",
		"verify:agents-sdk:routerai": "pnpm --filter @voxel-pilot/cli verify:agents-sdk:routerai",
		"generate:hsm": "pnpm --filter @voxel-pilot/cli generate:hsm",
		"test": "pnpm --filter @voxel-pilot/core test && pnpm --filter @voxel-pilot/cli test && tsx --test tests/*.test.ts",
		"format": "prettier --write \"packages/*/src/**/*.{ts,js}\" \"apps/*/src/**/*.{ts,js}\"",
		"knip": "knip",
		"check:imports": "node scripts/check-imports.mjs",
		"clean": "pnpm -r run clean"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"keywords": [
		"minecraft",
		"mineflayer",
		"xstate",
		"ai",
		"bot",
		"typescript",
		"openai"
	],
	"author": "kindyakov <kindyakov_2016@mail.ru>",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "https://github.com/kindyakov/voxel-pilot.git"
	},
	"bugs": {
		"url": "https://github.com/kindyakov/voxel-pilot/issues"
	},
	"homepage": "https://github.com/kindyakov/voxel-pilot#readme",
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"knip": "^6.0.0",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"@types/node": "^24.12.0"
	},
	"packageManager": "pnpm@12.6.0",
	"private": true
}
